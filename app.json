{
  "expo": {
    "name": "Mes Feux",
    "slug": "mes-feux",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mes-feux",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFD60A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.benoit.mesfeux",
      "infoPlist": {
        "NSCameraUsageDescription": "Mes Feux utilise la caméra pour allumer le flash en miroir du feu.",
        "NSPhotoLibraryUsageDescription": "Mes Feux utilise tes photos pour personnaliser les icônes de programmes.",
        "NSMicrophoneUsageDescription": "Mes Feux n'utilise pas le micro."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFD60A"
      },
      "package": "com.benoit.mesfeux",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Mes Feux utilise la caméra pour allumer le flash en miroir du feu."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mes Feux utilise tes photos pour personnaliser les icônes de programmes."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e30d8c9d-55db-4345-9b6a-9723d62e91b1"
      }
    }
  }
}
